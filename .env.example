# ============================================================
# WSO - White Suit Operator
# Plantilla de variables de entorno. Copiá este archivo a .env
# y completá los valores que apliquen.
# ============================================================

# Modo de operación: "local" o "cloud"
WSO_MODE=cloud

# --- Configuración local (Ollama u otro endpoint compatible) ---
WSO_LOCAL_URL=http://192.168.1.8:11434
WSO_LOCAL_MODEL=qwen2.5-coder:14b
# Tamaño del contexto en tokens. Reducir libera VRAM (KV cache).
# 8192 funciona bien para WSO. Si tu GPU tiene poca memoria probá 4096.
WSO_LOCAL_NUM_CTX=8192

# --- Configuración cloud (solo se usa si WSO_MODE=cloud) ---
# Providers soportados: anthropic | openai | google
WSO_CLOUD_PROVIDER=anthropic
# modelos recomendados:
# - Anthropic: cclaude-sonnet-4-5, claude-opus-4-7
# - OpenAI: gpt-4.1, gpt-4o-mini
# - Google: gemini-2.5-flash, gemini-2.5-pro
WSO_CLOUD_MODEL=claude-opus-4-7

# --- API Keys (cargá solo las que vayas a usar) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
