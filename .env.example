# ============================================================
# WSO - White Suit Operator
# Copiá este archivo a .env y completá lo que aplique.
# ============================================================

# Modo de operación: "local" (Ollama) o "cloud"
WSO_MODE=local

# --- Local (Ollama) ---
WSO_LOCAL_URL=http://localhost:11434
# Modelos con buen tool calling nativo. Probá y quedate con el que mejor ande
# en tu GPU: qwen2.5-coder:14b, qwen3:14b, ...
WSO_LOCAL_MODEL=qwen2.5-coder:14b
# Contexto en tokens. Con 16GB de VRAM y un 14B:
#   16384 → entra con KV cache normal (~12.5GB)
#   32768 → entra con KV cache q8_0. En el servidor de Ollama:
#           OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0
# Verificá con `ollama ps` que diga 100% GPU.
WSO_LOCAL_NUM_CTX=16384

# --- Cloud ---
# Providers: anthropic | openai (openai sirve para cualquier endpoint compatible)
WSO_CLOUD_PROVIDER=anthropic
WSO_CLOUD_MODEL=claude-opus-5-5
# Thinking adaptive visible y nivel de esfuerzo (low|medium|high|xhigh|max).
# Para modelos viejos que no los soportan: THINKING=false y EFFORT vacío.
WSO_ANTHROPIC_THINKING=true
WSO_ANTHROPIC_EFFORT=high

# Endpoint OpenAI-compatible (opcional). Ejemplos:
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
# WSO_OPENAI_BASE_URL=
# WSO_OPENAI_CONTEXT_WINDOW=128000

# --- API Keys (solo las que uses) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Loop ---
WSO_STEP_BUDGET=25            # tool calls por turno antes de preguntar si seguir
WSO_BASH_TIMEOUT=120          # segundos por comando (default)
WSO_BASH_MAX_TIMEOUT=600      # tope que el modelo puede pedir
WSO_BASH_MAX_OUTPUT_CHARS=10000

# --- Logs e historial ---
WSO_LOG_ENABLED=false
WSO_HISTORY_PERSIST=false
WSO_HISTORY_MAX_MESSAGES=200
