# ============================================================
# Permisos persistentes ("always allow") — plantilla
#
# Este archivo se genera solo cuando elegís "a" (aprobar siempre) en un
# prompt de permiso. Cada entrada significa que el agente puede hacer esa
# acción sin preguntarte nunca más: editalo con cuidado.
# ============================================================

# Comandos de bash: por prefijo. Nunca cubre comandos encadenados
# (`pytest && rm -rf x` siempre pregunta).
#
# [[allow]]
# tool = "bash"
# command_prefix = "pytest"

# Escrituras: por carpeta (fnmatch, `*` no es recursivo).
#
# [[allow]]
# tool = "edit_file"
# path_pattern = "/Users/coco/proyectos/mi-app/src/*"
