# ============================================================
# Permisos persistentes ("always allow") — plantilla
#
# Este archivo se genera automáticamente cuando elegís "[a] aprobar
# siempre" en un prompt de permiso. NO lo edites a mano salvo que
# sepas lo que estás haciendo: una entrada acá significa que el
# agente puede ejecutar esa acción sin preguntarte nunca más.
#
# Para empezar limpio, copialo a permissions.toml (o dejá que el
# agente lo cree solo).
# ============================================================

# Ejemplo de cómo se vería una entrada generada:
#
# [[allow]]
# tool = "write_file"
# path_pattern = "/Users/coco/Documents/DESAROLLO/wso-ai-harness/workspace/output/*"
# created_at = "2026-05-06T12:34:56"
